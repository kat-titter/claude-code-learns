{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "timeout": 10,
        "command": "python3 \"$HOME/.claude/skills/capture-lesson/scripts/feedback-nudge.py\"" } ] },
      { "hooks": [ { "type": "command", "timeout": 10,
        "command": "python3 \"$HOME/.claude/skills/capture-lesson/scripts/skill-router.py\"" } ] },
      { "hooks": [ { "type": "command", "timeout": 10,
        "command": "python3 \"$HOME/.claude/skills/prompt-practice/scripts/prompt-nudge.py\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "timeout": 10, "async": true,
        "command": "python3 \"$HOME/.claude/skills/capture-lesson/scripts/scan-corrections.py\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Skill", "hooks": [ { "type": "command", "timeout": 10, "async": true,
        "command": "python3 \"$HOME/.claude/skills/capture-lesson/scripts/skill-usage-log.py\"" } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "timeout": 10, "async": true,
        "command": "python3 \"$HOME/.claude/skills/capture-lesson/scripts/skill-usage-log.py\"" } ] }
    ]
  }
}
